<resources>
    <style name="Theme.Gaon360" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">@color/gaon_cyan</item>
        <item name="colorAccent">@color/gaon_cyan</item>
        <item name="android:windowBackground">@color/gaon_bg</item>
        <item name="android:statusBarColor">@color/gaon_bar</item>
        <item name="android:navigationBarColor">@color/gaon_bg</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Theme.Gaon360.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/gaon_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.Gaon360</item>
    </style>
</resources>
